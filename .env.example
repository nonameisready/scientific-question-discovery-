# Copy this file to `.env` (gitignored) and fill in real values.
# Never commit real credentials.

# NASA ADS API token — required before literature collection.
# Get one at: https://ui.adsabs.harvard.edu/user/settings/token
ADS_API_TOKEN=

# PostgreSQL + pgvector connection string — required only for the
# full-text vector index (src/vector_index/). Format:
#   postgresql://USER:PASSWORD@HOST:PORT/DBNAME
# Examples:
#   Local Docker:  postgresql://sqd:sqd@localhost:5432/sqd
#   Supabase/Neon: postgresql://user:pass@xxxx.pooler.supabase.com:5432/postgres
PG_DSN=

# Optional: override the data root (defaults to ./data)
# SQD_DATA_ROOT=data
